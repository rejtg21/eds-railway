# ---- Runtime ----
NODE_ENV=development
PORT=3001

# Which parts of the system this process runs:
#   all      -> HTTP API + outbox relay + consumers (single-process, easiest to run)
#   web      -> HTTP API only
#   relay    -> outbox relay poll loop only (+ /health)
#   consumer -> pg-boss consumers only (+ /health)
APP_ROLE=all

# ---- Database ----
# Pooled/app connection used by Prisma at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb?schema=public
# Direct (non-pooled) connection used by `prisma migrate deploy` and by pg-boss.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/appdb?schema=public
# Optional explicit connection for pg-boss. Falls back to DIRECT_URL then DATABASE_URL.
# MUST be a session-mode / direct connection (pg-boss is not compatible with transaction-mode poolers).
# PGBOSS_DATABASE_URL=

# ---- Outbox relay ----
# poll   -> relay dispatches PENDING rows every OUTBOX_POLL_INTERVAL_MS
# manual -> relay only runs when POST /outbox/drain is called (default)
OUTBOX_RELAY_MODE=manual
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10

# ---- Logging ----
LOG_LEVEL=debug
